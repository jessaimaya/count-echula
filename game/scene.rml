                <TextValueRun styleId="0:231" text="Swipe to pick a record, tap to play.&#10;Catch the candy on the beat to see in the dark.&#10;Keys: arrows or A/D to move, Enter to play,&#10;Space to ping, Esc to pause" name="Run"/>
