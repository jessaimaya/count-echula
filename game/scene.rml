<Rive version="1" kind="fragment">
    <!-- Draw order: earlier siblings draw ON TOP. Overlays first, the World layout last. -->
    <Artboard defaultStateMachineId="0:7" viewModelId="0:40" viewModelInstanceId="0:60" clip="true" width="540" height="960" styleId="0:5" name="Game" id="0:2">
