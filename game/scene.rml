            <Node x="270" y="420" name="Shelf" id="0:240">
                <Text x="-222" y="0" originX="0.5" originY="0.5" sizingValue="autoWidth" name="Prev Arrow" id="0:251">
                    <TextStylePaint fontSize="64" fontAssetId="0:31" familyName="Fredoka" styleName="Bold" name="Arrow Style" id="0:253">
