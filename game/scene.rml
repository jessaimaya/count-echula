                    </TextStylePaint>
                    <TextValueRun styleId="0:254" text="&gt;" name="Run"/>
                </Text>
                <!-- The LP. "Record" spins (Spin layer); "Flip" pops on GameVM.discFire. Swap in art freely. -->
                <Node x="0" y="0" name="Flip" id="0:241">
                    <Node x="0" y="0" name="Record" id="0:242">
                        <Shape x="0" y="0" name="Spindle" id="0:249">
                            <Ellipse width="10" height="10" name="Path"/>
                            <Fill name="Fill"><SolidColor colorValue="FF0B0A12" name="C"/></Fill>
                        </Shape>
                        <Shape x="22" y="-18" name="Label Mark" id="0:248">
                            <Ellipse width="14" height="14" name="Path"/>
                            <Fill name="Fill"><SolidColor colorValue="88FFFFFF" name="C"/></Fill>
                        </Shape>
                        <Shape x="0" y="0" name="Label" id="0:247">
                            <Ellipse width="96" height="96" name="Path"/>
                            <Fill name="Fill"><SolidColor colorValue="FFFF8A3D" name="C">
                                <DataBindContext sourcePathIds="0:40-0:2202" propertyKey="37"/>
                            </SolidColor></Fill>
                        </Shape>
                        <Shape x="0" y="0" name="Grooves" id="0:246">
                            <Ellipse width="236" height="236" name="Path"/>
                            <Ellipse width="200" height="200" name="Path 2"/>
                            <Ellipse width="164" height="164" name="Path 3"/>
                            <Ellipse width="128" height="128" name="Path 4"/>
                            <Stroke thickness="1.5" name="Stroke"><SolidColor colorValue="30FFFFFF" name="C"/></Stroke>
                        </Shape>
                        <Shape x="0" y="0" name="Sheen" id="0:245">
