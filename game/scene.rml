                <Text x="222" y="0" originX="0.5" originY="0.5" sizingValue="autoWidth" name="Next Arrow" id="0:252">
                    <TextStylePaint fontSize="64" fontAssetId="0:31" familyName="Fredoka" styleName="Bold" name="Arrow Style 2" id="0:254">
                        <Fill name="Fill"><SolidColor colorValue="999FE8FF" name="C"/></Fill>
