        <!-- ============ In-game HUD (mode 1) ============ -->
        <Node x="0" y="0" opacity="0" name="Hud" id="0:500">
            <!-- pause button: pinned to the top-right corner at any screen size. Its x is
                 GameVM.pauseX, which world.luau keeps at (width - PAUSE_SIZE / 2); PAUSE_SIZE
                 is also its top-right hit square -->
            <Node x="498" y="38" name="Pause Button" id="0:550">
                <DataBindContext sourcePathIds="0:40-0:2208" propertyKey="13" id="0:7665"/>
                <Shape x="-7" y="0" name="Bar L" id="0:552">
