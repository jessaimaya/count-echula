<Rive version="1" kind="fragment">
    <!-- Draw order: earlier siblings draw ON TOP. Overlays first, the World layout last. -->
    <Artboard defaultStateMachineId="0:7" viewModelId="0:40" viewModelInstanceId="0:60" clip="true" width="540" height="960" styleId="0:5" name="Game" id="0:2">
        <Fill name="Background">
            <SolidColor colorValue="FF141032" name="Color"/>
        </Fill>
        <LayoutComponentStyle name="Artboard Style" id="0:5"/>

        <!-- ============ Pause menu (GameVM.paused); hit areas live in world.luau (RESUME_Y, MENU_Y) ============ -->
        <Node x="0" y="0" opacity="0" name="Pause" id="0:2100">
            <Text x="270" y="576" originX="0.5" originY="0.5" sizingValue="autoWidth" name="Menu Label" id="0:2141">
