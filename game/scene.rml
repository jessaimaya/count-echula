                    </StateTransition>
                </AnimationState>
                <AnimationState x="400" y="0" animationId="0:702" id="0:602">
                    <StateTransition stateToId="0:603" duration="400">
                        <TransitionViewModelCondition opValue="greaterThanOrEqual">
