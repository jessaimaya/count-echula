        </Node>

        <!-- ============ Judgement pop over the bat ============ -->
        <Node x="270" y="470" opacity="0" name="Pop" id="0:400">
            <Text x="0" y="0" originX="0.5" originY="0.5" sizingValue="autoWidth" name="Judge" id="0:401">
