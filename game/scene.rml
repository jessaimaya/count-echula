        <!-- ============ In-game HUD (mode 1) ============ -->
        <Node x="0" y="0" opacity="0" name="Hud" id="0:500">
            <!-- pause button: world.luau PAUSE_SIZE is its top-right hit square -->
            <Node x="498" y="38" name="Pause Button" id="0:550">
                <Shape x="-7" y="0" name="Bar L" id="0:552">
                    <Rectangle width="7" height="22" cornerRadiusTL="2" cornerRadiusTR="2" cornerRadiusBL="2" cornerRadiusBR="2" name="Path"/>
                    <Fill name="Fill"><SolidColor colorValue="FFFFFFFF" name="C"/></Fill>
                </Shape>
                <Shape x="7" y="0" name="Bar R" id="0:553">
                    <Rectangle width="7" height="22" cornerRadiusTL="2" cornerRadiusTR="2" cornerRadiusBL="2" cornerRadiusBR="2" name="Path"/>
                    <Fill name="Fill"><SolidColor colorValue="FFFFFFFF" name="C"/></Fill>
                </Shape>
                <Shape x="0" y="0" name="Ring" id="0:551">
                    <Ellipse width="52" height="52" name="Path"/>
                    <Fill name="Fill"><SolidColor colorValue="66141032" name="C"/></Fill>
                    <Stroke thickness="2" name="Stroke"><SolidColor colorValue="99FFFFFF" name="C"/></Stroke>
                </Shape>
            </Node>
            <Text x="270" y="330" width="480" originX="0.5" sizingValue="autoHeight" alignValue="center" name="Prompt" id="0:530">
                <TextStylePaint fontSize="32" fontAssetId="0:31" familyName="Fredoka" styleName="SemiBold" name="Prompt Style" id="0:531">
                    <Fill name="Fill"><SolidColor colorValue="FFFFFFFF" name="C"/></Fill>
                    <TextStyleAxis tag="2003265652" axisValue="600" name="Weight"/>
                </TextStylePaint>
                <TextValueRun styleId="0:531" text="" name="Run">
                    <DataBindContext sourcePathIds="0:40-0:46" propertyKey="268"/>
