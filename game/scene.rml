        <!-- ============ Title screen (mode 0): the record shelf ============ -->
        <!-- Swipe or tap the side strips to flip records (world.luau ARROW_W, SHELF_TOP/BOTTOM). -->
        <Node x="0" y="0" opacity="1" name="Title" id="0:200">
            <Text x="270" y="790" width="480" originX="0.5" sizingValue="autoHeight" alignValue="center" name="Hint" id="0:230">
                <TextStylePaint fontSize="20" lineHeight="30" fontAssetId="0:31" familyName="Fredoka" styleName="Medium" name="Hint Style" id="0:231">
                    <Fill name="Fill"><SolidColor colorValue="FFB8B0E0" name="C"/></Fill>
