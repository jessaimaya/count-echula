                    </Node>
                </Node>
            </Node>
            <Text x="270" y="70" width="500" originX="0.5" sizingValue="autoHeight" alignValue="center" name="Logo" id="0:210">
                <TextStylePaint fontSize="80" lineHeight="76" fontAssetId="0:30" familyName="Creepster" styleName="Regular" name="Logo Style" id="0:211">
                    <Fill name="Fill"><SolidColor colorValue="FFFF9F3D" name="C"/></Fill>
                </TextStylePaint>
                <TextValueRun styleId="0:211" text="Count&#10;Echula" name="Run"/>
