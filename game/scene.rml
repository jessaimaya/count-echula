        <!-- ============ The playfield (GPU Canvas world + temporary HUD shapes) ============ -->
        <LayoutComponent width="540" height="960" styleId="0:11" name="Root Layout" id="0:10">
            <LayoutComponentStyle layoutWidthScaleType="1" layoutHeightScaleType="1" widthUnitsValue="3" heightUnitsValue="3" name="Layout Style" id="0:11"/>
            <!-- FocusData: the World script's keyboardEvent only runs while this node holds focus -->
            <ScriptedLayout scriptAssetId="0:85" name="World" id="0:12">
                <FocusData/>
                <!-- Art from svg/ (art.rml); names match world.luau's Input<Artboard> fields -->
                <ScriptInputArtboard artboardId="0:5000" name="echulaArt"/>
                <ScriptInputArtboard artboardId="0:5100" name="garlicArt"/>
                <ScriptInputArtboard artboardId="0:5200" name="candyPinkArt"/>
                <ScriptInputArtboard artboardId="0:5300" name="candyOrangeArt"/>
                <ScriptInputArtboard artboardId="0:5400" name="moonArt"/>
                <ScriptInputArtboard artboardId="0:5500" name="cloudArt"/>
                <ScriptInputArtboard artboardId="0:5600" name="lampArt"/>
                <ScriptInputArtboard artboardId="0:5700" name="fenceArt"/>
                <ScriptInputArtboard artboardId="0:5800" name="stakeArt"/>
            </ScriptedLayout>
        </LayoutComponent>

        <!-- ============ State machine ============ -->
        <StateMachine name="Flow" id="0:7">
            <!-- Screens: which overlay is visible, from GameVM.mode. Every screen focuses the
                 World layout so the keyboard works when embedded (the CLI player fakes this). -->
            <StateMachineLayer name="Screens" id="0:8">
                <AnyState x="0" y="-120"/>
                <ExitState x="600" y="-120"/>
                <EntryState x="0" y="0">
                    <StateTransition stateToId="0:601"/>
                </EntryState>
                <AnimationState x="200" y="0" animationId="0:701" id="0:601">
                    <FocusActionTarget targetId="0:12"/>
                    <StateTransition stateToId="0:602" duration="250">
                        <TransitionViewModelCondition opValue="equal">
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyNumber>
                                    <DataBindContext sourcePathIds="0:40-0:41" propertyKey="636"/>
                                </BindablePropertyNumber>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueNumberComparator value="1"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnimationState>
                <AnimationState x="400" y="0" animationId="0:702" id="0:602">
                    <FocusActionTarget targetId="0:12"/>
                    <StateTransition stateToId="0:603" duration="400">
                        <TransitionViewModelCondition opValue="greaterThanOrEqual">
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyNumber>
                                    <DataBindContext sourcePathIds="0:40-0:41" propertyKey="636"/>
                                </BindablePropertyNumber>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueNumberComparator value="2"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                    <StateTransition stateToId="0:601" duration="300">
                        <TransitionViewModelCondition opValue="equal">
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyNumber>
                                    <DataBindContext sourcePathIds="0:40-0:41" propertyKey="636"/>
                                </BindablePropertyNumber>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueNumberComparator value="0"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnimationState>
                <AnimationState x="400" y="160" animationId="0:703" id="0:603">
                    <FocusActionTarget targetId="0:12"/>
                    <StateTransition stateToId="0:602" duration="250">
                        <TransitionViewModelCondition opValue="equal">
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyNumber>
                                    <DataBindContext sourcePathIds="0:40-0:41" propertyKey="636"/>
                                </BindablePropertyNumber>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueNumberComparator value="1"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                    <StateTransition stateToId="0:601" duration="300">
                        <TransitionViewModelCondition opValue="equal">
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyNumber>
                                    <DataBindContext sourcePathIds="0:40-0:41" propertyKey="636"/>
                                </BindablePropertyNumber>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueNumberComparator value="0"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnimationState>
            </StateMachineLayer>

            <!-- Judgement pop: fires on GameVM.judgeFire -->
            <StateMachineLayer name="Judge Pop" id="0:9">
                <AnyState x="0" y="-120">
                    <StateTransition stateToId="0:612">
                        <TransitionViewModelCondition>
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyTrigger>
                                    <DataBindContext sourcePathIds="0:40-0:50" propertyKey="686"/>
                                </BindablePropertyTrigger>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueTriggerComparator/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnyState>
                <ExitState x="600" y="-120"/>
                <EntryState x="0" y="0">
                    <StateTransition stateToId="0:611"/>
                </EntryState>
                <AnimationState x="200" y="0" animationId="0:711" id="0:611"/>
                <AnimationState x="400" y="0" animationId="0:712" reset="true" id="0:612">
                    <StateTransition stateToId="0:611" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100"/>
                </AnimationState>
            </StateMachineLayer>

            <!-- Candy count pop: fires on GameVM.candyFire -->
            <StateMachineLayer name="Count Pop" id="0:13">
                <AnyState x="0" y="-120">
                    <StateTransition stateToId="0:622">
                        <TransitionViewModelCondition>
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyTrigger>
                                    <DataBindContext sourcePathIds="0:40-0:51" propertyKey="686"/>
                                </BindablePropertyTrigger>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueTriggerComparator/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnyState>
                <ExitState x="600" y="-120"/>
                <EntryState x="0" y="0">
                    <StateTransition stateToId="0:621"/>
                </EntryState>
                <AnimationState x="200" y="0" animationId="0:721" id="0:621"/>
                <AnimationState x="400" y="0" animationId="0:722" reset="true" id="0:622">
                    <StateTransition stateToId="0:621" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100"/>
                </AnimationState>
            </StateMachineLayer>

            <!-- Idle: "TAP TO START" breathes on the beat (120 BPM) -->
            <StateMachineLayer name="Idle" id="0:14">
                <AnyState x="0" y="-120"/>
                <ExitState x="600" y="-120"/>
                <EntryState x="0" y="0">
                    <StateTransition stateToId="0:631"/>
                </EntryState>
                <AnimationState x="200" y="0" animationId="0:731" id="0:631"/>
            </StateMachineLayer>

            <!-- Pause: the overlay follows GameVM.paused -->
            <StateMachineLayer name="Pause" id="0:15">
                <AnyState x="0" y="-120"/>
                <ExitState x="600" y="-120"/>
                <EntryState x="0" y="0">
                    <StateTransition stateToId="0:641"/>
                </EntryState>
                <AnimationState x="200" y="0" animationId="0:741" id="0:641">
                    <StateTransition stateToId="0:642" duration="150">
                        <TransitionViewModelCondition opValue="equal">
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyBoolean>
                                    <DataBindContext sourcePathIds="0:40-0:2206" propertyKey="634"/>
                                </BindablePropertyBoolean>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueBooleanComparator value="true"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnimationState>
                <AnimationState x="400" y="0" animationId="0:742" id="0:642">
                    <StateTransition stateToId="0:641" duration="150">
                        <TransitionViewModelCondition opValue="equal">
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyBoolean>
                                    <DataBindContext sourcePathIds="0:40-0:2206" propertyKey="634"/>
                                </BindablePropertyBoolean>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueBooleanComparator value="false"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnimationState>
            </StateMachineLayer>

            <!-- Record flip: pops the LP on GameVM.discFire -->
            <StateMachineLayer name="Record Flip" id="0:16">
                <AnyState x="0" y="-120">
                    <StateTransition stateToId="0:652">
                        <TransitionViewModelCondition>
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyTrigger>
                                    <DataBindContext sourcePathIds="0:40-0:2207" propertyKey="686"/>
                                </BindablePropertyTrigger>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueTriggerComparator/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnyState>
                <ExitState x="600" y="-120"/>
                <EntryState x="0" y="0">
                    <StateTransition stateToId="0:651"/>
                </EntryState>
                <AnimationState x="200" y="0" animationId="0:751" id="0:651"/>
                <AnimationState x="400" y="0" animationId="0:752" reset="true" id="0:652">
                    <StateTransition stateToId="0:651" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100"/>
                </AnimationState>
            </StateMachineLayer>

            <!-- Spin: the LP turns, one revolution per bar at 120 BPM -->
            <StateMachineLayer name="Spin" id="0:17">
                <AnyState x="0" y="-120"/>
                <ExitState x="600" y="-120"/>
                <EntryState x="0" y="0">
